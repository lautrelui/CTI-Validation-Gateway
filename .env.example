# IVS Configuration
# Set IVS_MODE=external to connect to a real IVS instance
# Default is "simulator" (embedded mock for development)
IVS_MODE=external
IVS_BASE_URL=http://192.168.10.168:3011
IVS_API_KEY=your-ivs-api-key-here

# IVS Claim Signature Verification
# The IVS signs claims with HS512 (HMAC-SHA512). Set the shared signing key here.
IVS_SIGNING_KEY=same-value-as-IVS-SIGNING_KEY-env-var
# Verification mode: 'local' (verify with shared key), 'remote' (POST to IVS /claims/verify),
#                    'auto' (local if key set, else remote if external, else RSA), 'none' (skip)
# IVS_CLAIM_VERIFY_MODE=auto

# Optional: health check interval in milliseconds (default 15000)
# IVS_HEALTH_CHECK_INTERVAL=15000

# Optional: cookie security (set to true when using HTTPS)
# CVG_COOKIE_SECURE=true
